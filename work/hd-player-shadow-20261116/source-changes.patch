+void prepareShadow(HdPlayerFrame& frame)
+{
+    const int width = frame.canvasWidth() * 4;
+    const int height = frame.canvasHeight() * 4;
+    frame.shadow.resize(static_cast<size_t>(width) * height);
+    // One stationary ground-plane footprint for the whole cycle: changing the
+    // silhouette of the swinging legs must not make this ambient shadow pulse.
+    // Keep floor(width / 2) in native coordinates, including odd-width frames.
+    const double cx = (kHdPlayerShadowPadX + frame.width / 2 - 1) * 4.0;
+    const double cy = (frame.height - 3) * 4.0;
+    for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x) {
+        const double dx = (x + 0.5 - cx) / (17.0 * 4);
+        const double dy = (y + 0.5 - cy) / (7.0 * 4);
+        const double falloff = std::max(0.0, 1.0 - dx * dx - dy * dy);
+        frame.shadow[static_cast<size_t>(y) * width + x]
+            = static_cast<unsigned char>(90.0 * falloff * falloff + 0.5);
+    }
+}
 
